# Copy to .env.local (git-ignored). Everything with a VITE_ prefix is compiled into the public JavaScript bundle:
# NEVER put passwords, session secrets, database credentials or API keys here.

# Full API base INCLUDING /api, https only, no trailing slash. Production (.env.production / Render):
#   VITE_API_URL=https://pnms-backend.onrender.com/api
# Leave EMPTY for local development: requests go to same-origin /api and the Vite dev proxy forwards them
# (see FRONTEND_API_PROXY), so no CORS or cross-site cookies are involved.
VITE_API_URL=

# Vite DEV-SERVER proxy target only (not bundled, not used in production builds).
FRONTEND_API_PROXY=https://localhost:3001
# Path to the mkcert root CA (run `mkcert -CAROOT` to find the folder; file is rootCA.pem). Lets the dev proxy trust the
# backend's local certificate WITHOUT disabling certificate validation.
DEV_CA_PATH=

# Keep in sync with backend MR_NUMBER_REGEX and REMARKS_MAX_LENGTH.
VITE_MR_NUMBER_REGEX=^[0-9]{5,20}$
VITE_REMARKS_MAX_LENGTH=1000
# Enable only after hospital approval; these are UI policies, not server authorization.
VITE_ALLOW_MANUAL_MR=false
VITE_ALLOW_REMARKS=false
