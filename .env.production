# Public build-time settings for production builds. No secrets here (everything VITE_* is visible in the browser).
# Frontend (https://pnms-mobile.onrender.com) and API are separate Render services, so the browser calls the API directly.
# The API must allow this origin: FRONTEND_URL=https://pnms-mobile.onrender.com, COOKIE_SECURE=true, COOKIE_SAME_SITE=none.
VITE_API_URL=https://pnms-backend.onrender.com/api
VITE_MR_NUMBER_REGEX=^[0-9]{5,20}$
VITE_REMARKS_MAX_LENGTH=1000
VITE_ALLOW_MANUAL_MR=false
VITE_ALLOW_REMARKS=false
